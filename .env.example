# Copy to .env and fill in the keys you have. Providers without a key are skipped.
VTO_ANTHROPIC_API_KEY=
VTO_LLM_MODEL=claude-opus-5-5
VTO_DEEPGRAM_API_KEY=
VTO_OPENAI_API_KEY=
VTO_ASSEMBLYAI_API_KEY=
VTO_TRANSCRIPTION_PROVIDERS=deepgram,whisper,assemblyai
VTO_TRANSCRIPTION_TIMEOUT_SECONDS=60
VTO_WORK_DIR=./data

# --- Run locally (free, no cloud keys): see README "Run locally" ---
# Speech-to-text in-process via faster-whisper (pip install -e '.[local]'); no key needed.
# Add whisper-local to the list to run it beside the cloud providers, or use it alone:
# VTO_TRANSCRIPTION_PROVIDERS=whisper-local
# VTO_LOCAL_WHISPER_MODEL=small
# VTO_LOCAL_WHISPER_COMPUTE_TYPE=int8
# VTO_LOCAL_WHISPER_DEVICE=auto
# VTO_LOCAL_WHISPER_TIMEOUT_SECONDS=300
# LLM via any OpenAI-compatible server, e.g. Ollama (ollama pull qwen2.5:14b-instruct).
# VTO_LLM_PROVIDER=openai_compatible
# VTO_LLM_BASE_URL=http://localhost:11434/v1
# VTO_LLM_MODEL=qwen2.5:14b-instruct
# VTO_LLM_API_KEY=
# VTO_LLM_TIMEOUT_SECONDS=120
